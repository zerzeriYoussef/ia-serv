# Application
APP_NAME="AI Data Analytics Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
HOST=0.0.0.0
PORT=8001

# Database
DATABASE_URL="postgresql+asyncpg://postgres:admin@localhost:5432/ai_service"
PGCLIENTENCODING=UTF8
PGSSLMODE=disable
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=["csv", "xlsx", "xls", "json", "parquet"]

# Security
SECRET_KEY="change-me-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring
LOG_LEVEL="INFO"
CORS_ORIGINS=["http://localhost:4200", "http://localhost:5173", "http://localhost"]
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

SERPER_API_KEY=your-serper-api-key
REPORT_RETRIEVAL_TOP_K=5
REPORT_CACHE_TTL=3600
